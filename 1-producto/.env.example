# =====================================================================
# VARIABLES DE ENTORNO DEL ASISTENTE ESCOLAR
# Copia este archivo como .env y rellena los valores.
# El archivo .env NUNCA debe subirse a un repositorio.
# =====================================================================

# Puerto en el que escucha el servidor
PORT=3000

# Clave de la API de Google Gemini (https://aistudio.google.com/)
# Si se deja vacía, el asistente arranca igualmente en modo básico
# (botones y buscador local, sin IA y sin coste).
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# LLAVE DE ARRANQUE DEL PANEL
# ---------------------------------------------------------------------
# Sirve para entrar la PRIMERA vez y crear el primer acceso personal.
# En cuanto ese acceso existe, esta contraseña deja de valer y cada
# persona entra con el suyo.
#
# Para generar el hash:
#   node -e "console.log(require('crypto').createHash('sha256').update('TU_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Alternativa solo para pruebas locales:
# ADMIN_PASSWORD=cambia_esta_password

# ---------------------------------------------------------------------
# DOMINIOS AUTORIZADOS  ·  ESTO CUESTA DINERO SI SE DEJA MAL
# ---------------------------------------------------------------------
# Con el asterisco, CUALQUIER web puede llamar a esta API y gastar la
# cuota de IA del centro. No expone datos —el panel va con contraseña—
# pero la factura la paga el colegio.
#
# En producción hay que poner los dominios reales del centro:
#   ORIGENES_PERMITIDOS=https://www.micolegio.es,https://micolegio.es
#
# El servidor avisa al arrancar si esto se queda en «*».
ORIGENES_PERMITIDOS=*

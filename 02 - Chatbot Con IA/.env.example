# =====================================================================
# VARIABLES DE ENTORNO DEL ASISTENTE ESCOLAR
# Copia este archivo como .env y rellena los valores.
# El archivo .env NUNCA debe subirse a un repositorio.
# =====================================================================

# Puerto en el que escucha el servidor
PORT=3000

# Clave de la API de Google Gemini (gratuita en https://aistudio.google.com/)
# Si se deja vacía, el asistente arranca igualmente en modo básico
# (determinista, sin IA y sin coste).
GEMINI_API_KEY=

# Acceso al panel de administración (/admin).
# RECOMENDADO: usar el hash en lugar de la contraseña en texto plano.
# Para generar el hash de tu contraseña ejecuta:
#   node -e "console.log(require('crypto').createHash('sha256').update('TU_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Alternativa desaconsejada (solo para pruebas locales):
# ADMIN_PASSWORD=cambia_esta_password

# Dominios autorizados a incrustar el widget, separados por comas.
# En producción hay que sustituir el asterisco por los dominios reales.
# Ejemplo: ORIGENES_PERMITIDOS=https://www.micolegio.es,https://micolegio.es
ORIGENES_PERMITIDOS=*
